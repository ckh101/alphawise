{
  "name": "alphawise",
  "version": "0.1.0",
  "description": "灵智投研助手前端应用",
  "main": "main.js",
  "scripts": {
    "dev": "npm run gen-icons && set NODE_ENV=development && electron .",
    "start": "electron .",
    "gen-icons": "node scripts/gen-icons.js",
    "sync-backend": "node scripts/sync-backend.js",
    "build": "npm run gen-icons && npm run sync-backend && cross-env ELECTRON_MIRROR=https://registry.npmmirror.com/-/binary/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://registry.npmmirror.com/-/binary/electron-builder-binaries/ ELECTRON_CACHE=./.cache/electron ELECTRON_BUILDER_CACHE=./.cache/electron-builder electron-builder",
    "build:win": "npm run gen-icons && npm run sync-backend && cross-env ELECTRON_MIRROR=https://registry.npmmirror.com/-/binary/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://registry.npmmirror.com/-/binary/electron-builder-binaries/ ELECTRON_CACHE=./.cache/electron ELECTRON_BUILDER_CACHE=./.cache/electron-builder electron-builder --win",
    "build:mac": "npm run gen-icons && npm run sync-backend && electron-builder --mac",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix"
  },
  "keywords": [
    "electron",
    "investment",
    "research",
    "stock",
    "ai"
  ],
  "author": "Harness Team",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "png2icons": "^2.0.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.6.5",
    "better-sqlite3": "^12.10.0",
    "echarts": "^5.4.3",
    "fastify": "^5.8.5",
    "js-yaml": "^4.1.1",
    "marked": "^11.1.1",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.harness.investment-research",
    "productName": "灵智投研助手",
    "copyright": "Copyright © 2024 Harness Team",
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "src/**/*",
      "package.json",
      "icon.png"
    ],
    "asarUnpack": [
      "server/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "build-backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__",
          "!**/__pycache__",
          "!*.pyc",
          "!**/*.pyc",
          "!data/*.db",
          "!data/*.db-*",
          "!logs",
          "!**/.env",
          "!**/get-pip.py",
          "!**/tests",
          "!**/*.dist-info/tests"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "灵智投研助手-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": 2052,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "灵智投研助手",
      "allowElevation": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "installerHeaderIcon": "resources/icon.ico",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "artifactName": "灵智投研助手-${version}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "灵智投研助手 ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icon.png"
    }
  }
}
